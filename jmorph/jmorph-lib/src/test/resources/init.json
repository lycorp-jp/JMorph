{
  "description": "sample JMorph config",

  "analyzer": {
    "dictionary": {
      "baseDic": {
        "type": "mecab",
        "location": "./src/test/resources/mecab-small-dic/final"
      },
      "additionalDic": [],
      "unknownDic": {
        "type": "basic",
        "concatMode": "ALL_EXCEPT_KATAKANA"
